# Application Settings
APP_NAME=LLM Chat Platform
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=3211

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/llm_chat.db

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3212

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/markdown

# Default API Keys (Optional - can be configured via UI)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
